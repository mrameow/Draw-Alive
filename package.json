{
  "name": "draw-alive",
  "productName": "Draw Alive",
  "version": "1.0.0",
  "description": "Draw, colour or photograph a creature and watch it come alive in animated worlds.",
  "main": "electron/main.js",
  "author": "Draw Alive",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "node scripts/serve.js",
    "desktop": "electron .",
    "dist:win": "electron-builder --win nsis portable --x64",
    "android:add": "cap add android && node scripts/prepare-android.js",
    "android:sync": "cap sync android",
    "test": "node tests/e2e.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "playwright": "^1.50.0"
  },
  "build": {
    "appId": "com.drawalive.app",
    "productName": "Draw Alive",
    "copyright": "Draw Alive",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "web/**/*",
      "resources/icon.ico",
      "resources/icon-256.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Draw Alive",
      "artifactName": "Draw-Alive-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Draw-Alive-Portable-${version}.exe"
    }
  }
}
